{
  "id": "com.hadabadra.gvulot-eruv",
  "name": "גבולות עירוב",
  "version": "0.3.2",
  "description": "מפות העירובים השכונתיים והאחראים, תחום שבת והחוברות \"דרך התחומין\", ספריית עירובין ועירובין בחו\"ל — מתוך מוקד העירוב ובאישורו.",
  "author": "לזש\"ק לרמב\"ר ומבק\"י",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "beta",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "permissions": [
    "app.open_url",
    "app.info.read",
    "events.subscribe:theme.changed",
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "network.localhost",
    "fs.user_files.read",
    "library.books.read",
    "reader.open",
    "fs.user_files.write",
    "reader.toolbar",
    "app.startup_contributions",
    "app.shortcuts",
    "navigation.write"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "גבולות עירוב",
      "order": 215,
      "defaultPinned": false,
      "iconName": "fluent:map_24_regular"
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "open-eruv",
          "title": "גבולות עירוב",
          "icon": "fluent:map_24_regular",
          "contexts": [
            "reader-text"
          ],
          "openPlugin": true,
          "when": {
            "not": {
              "storage": {
                "key": "hideToolbar",
                "equals": true
              }
            }
          }
        }
      ],
      "shortcuts": [
        {
          "id": "open-eruv-shortcut",
          "label": "פתיחת גבולות עירוב",
          "key": "ctrl+alt+e",
          "command": "open"
        }
      ]
    }
  },
  "homepage": "https://github.com/Hadabadra/gvulot-eruv",
  "icon": "icon.png"
}
