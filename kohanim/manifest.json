{
  "id": "com.hadabadra.tahorat-kohanim",
  "name": "טהרת כהנים",
  "version": "2.2.0",
  "description": "המדריך לכהנים, מפות, חוברות, אזורים אסורים על המפה ולוח טיסות — מהתאחדות טהרת הכהנים ובאישורם. הכל בתוך התוסף, בלי אינטרנט מלבד ההורדה.",
  "author": "לזש\"ק לרמב\"ר ומבק\"י",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "stable",
  "minAppVersion": "0.9.98.3",
  "entrypoint": "index.html",
  "permissions": [
    "app.open_url",
    "app.info.read",
    "events.subscribe:theme.changed",
    "events.subscribe:settings.changed",
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "network.localhost",
    "fs.user_files.read",
    "library.books.read",
    "reader.open",
    "fs.user_files.write",
    "reader.toolbar",
    "app.startup_contributions",
    "app.shortcuts",
    "navigation.write",
    "plugin.open_other",
    "network.access",
    "search.field_actions",
    "settings.read",
    "calendar.read"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost",
      "https://nominatim.openstreetmap.org/search"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "טהרת כהנים",
      "order": 216,
      "defaultPinned": false,
      "iconName": "shield_24_regular"
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "open-kohanim",
          "title": "טהרת כהנים",
          "icon": "shield_24_regular",
          "contexts": [
            "reader-text"
          ],
          "openPlugin": true,
          "when": {
            "not": {
              "storage": {
                "key": "hideToolbar",
                "equals": true
              }
            }
          }
        }
      ],
      "shortcuts": [
        {
          "id": "open-kohanim-shortcut",
          "label": "פתיחת טהרת כהנים",
          "key": "ctrl+alt+k",
          "command": "open"
        }
      ],
      "searchFieldActions": [
        {
          "id": "find-kohanim",
          "title": "חיפוש בטהרת כהנים לפי העיר, הרחוב או האתר שבשדה",
          "icon": "shield_24_regular",
          "activeIcon": "shield_24_filled",
          "fields": [
            "library",
            "fullText"
          ],
          "visibleWhen": "nonEmptyText"
        }
      ]
    }
  },
  "homepage": "https://github.com/Hadabadra/gvulot-eruv/tree/main/kohanim",
  "icon": "icon.png"
}
